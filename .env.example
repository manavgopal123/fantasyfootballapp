# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres — from Project Settings > Database in the Supabase
# dashboard. Two different connection strings, both via the pooler:
#   DATABASE_URL — the "Transaction" pooler connection (port 6543). Used by
#                   the running app.
#   DIRECT_URL   — the "Session" pooler connection (port 5432). Used only by
#                   Prisma's CLI (migrate, studio) — DDL and advisory locks
#                   don't work reliably through transaction-mode pooling.
#                   NOTE: don't use Supabase's true "direct connection" host
#                   (db.<ref>.supabase.co) here — it's IPv6-only, and Vercel's
#                   build/serverless environment doesn't support outbound
#                   IPv6, so migrations fail with a P1001 connection error
#                   there even though it works fine locally. The Session
#                   pooler is IPv4-compatible and behaves like a direct
#                   connection for migration purposes.
DATABASE_URL=""
DIRECT_URL=""

# Random secret used by NextAuth to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
