# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres — from Project Settings > Database in the Supabase
# dashboard. Two different connection strings:
#   DATABASE_URL — the "Transaction" pooler (Supavisor/PgBouncer) connection.
#                   Used by the running app.
#   DIRECT_URL   — the direct (non-pooled) connection. Used only by Prisma's
#                   CLI (migrate, studio) — DDL and advisory locks don't work
#                   reliably through a transaction-mode pooler.
DATABASE_URL=""
DIRECT_URL=""

# Random secret used by NextAuth to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
